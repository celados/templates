# Drizzle Kit uses a direct primary connection for schema migrations.
DATABASE_URL=postgresql://user:password@host.horizon.psdb.cloud:5432/postgres?sslmode=verify-full

# Wrangler uses this only for local Hyperdrive development. Runtime production
# traffic uses the Hyperdrive configuration ID in wrangler.jsonc.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host.horizon.psdb.cloud:5432/postgres?sslmode=verify-full
