{
	"name": "template-cloudflare-worker",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/api-contract"
	],
	"type": "module",
	"scripts": {
		"prepare": "bun scripts/install-skills.mjs && bun run build:contract",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "bun run build:contract && wrangler deploy --dry-run --outdir dist/worker",
		"build:contract": "bun run --cwd packages/api-contract build",
		"check": "bun run build:contract && vp check && tsc --noEmit && bun run cf-typegen --check && bun run verify:template && bun run test && bun run pack:check && bun run deadcode",
		"deadcode": "fallow dead-code",
		"test": "vp test --run",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts",
		"verify:template": "bun scripts/verify-template.ts",
		"pack:check": "bun run --cwd packages/api-contract pack:check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@app/api-contract": "workspace:*",
		"@better-auth/drizzle-adapter": "^1.7.5",
		"@orpc/server": "2.0.0-beta.39",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.45.3",
		"evlog": "^2.29.0",
		"hono": "^4.13.8",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/pg": "^8.23.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"fallow": "^3.28.0",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.136.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	}
}
