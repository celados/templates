{
	"name": "template-solid-start-extension",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "wxt prepare",
		"dev": "wxt --browser chrome",
		"build": "wxt build --browser chrome && bun scripts/verify-build.ts",
		"zip": "wxt zip --browser chrome && bun scripts/verify-build.ts",
		"check": "tsc --noEmit && bun run test",
		"test": "vp test --run",
		"test:e2e": "node tests/e2e/system-chrome.ts",
		"chrome": "CHROME_HEADLESS=1 bun scripts/system-chrome.ts .output/chrome-mv3",
		"chrome:dev": "bun scripts/system-chrome.ts .output/chrome-mv3-dev"
	},
	"dependencies": {
		"@orpc/client": "^1.15.1",
		"@orpc/server": "^1.15.1",
		"@sentry/browser": "^10.75.0",
		"@solidjs/web": "2.0.0-rc.9",
		"@stylexjs/stylex": "^0.19.1",
		"@wxt-dev/i18n": "^0.2.7",
		"solid-js": "2.0.0-rc.9",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@solidjs/diagnostics": "2.0.0-rc.9",
		"@solidjs/testing-library": "1.0.0-beta.3",
		"@solidjs/vite-plugin": "3.0.0-next.44",
		"@stylexjs/unplugin": "^0.19.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/bun": "^1.4.2",
		"@types/chrome": "^0.3.0",
		"@wxt-dev/auto-icons": "^1.1.2",
		"jsdom": "^30.1.0",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.3",
		"wxt": "^0.21.4"
	}
}
