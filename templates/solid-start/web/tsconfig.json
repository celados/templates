{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "../convex/**/*.ts"]
}
