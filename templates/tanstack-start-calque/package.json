{
	"name": "template-tanstack-start-calque",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "bun scripts/install-skills.mjs",
		"dev": "wireit",
		"routegen": "wireit",
		"cf-typegen": "wireit",
		"codegen": "wireit",
		"build": "wireit",
		"preview": "vp preview .",
		"preview:static": "bun scripts/serve-static.ts",
		"test": "vp test --run --config tooling/vitest.config.ts",
		"test:ssg": "playwright test",
		"verify:ssg": "bun scripts/verify-ssg.ts",
		"check": "bun run codegen && vp check && tsc --noEmit && bun run cf-typegen:check",
		"cf-typegen:check": "wrangler types src/worker-configuration.d.ts --check",
		"deploy": "bun run build && wrangler deploy",
		"deploy:static": "bun run build && wrangler deploy --config wrangler.static.jsonc",
		"deploy:temporary": "bun run build && wrangler deploy --temporary"
	},
	"wireit": {
		"dev": {
			"command": "vp dev --port 3000 --strictPort",
			"service": true,
			"dependencies": [
				"codegen"
			]
		},
		"routegen": {
			"command": "tsr generate",
			"files": [
				"bun.lock",
				"package.json",
				"tsr.config.json",
				"src/routes/**/*"
			],
			"output": [
				"src/route-tree.gen.ts"
			]
		},
		"cf-typegen": {
			"command": "wrangler types src/worker-configuration.d.ts",
			"files": [
				"package.json",
				"wrangler.jsonc"
			],
			"output": [
				"src/worker-configuration.d.ts"
			]
		},
		"codegen": {
			"dependencies": [
				"routegen",
				"cf-typegen"
			]
		},
		"build": {
			"command": "vp build . && bun scripts/verify-ssg.ts",
			"dependencies": [
				"codegen"
			]
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.31",
		"@tanstack/react-start": "^1.168.48",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.50.0",
		"@mdx-js/rollup": "^3.1.1",
		"@playwright/test": "^1.62.1",
		"@tanstack/devtools-vite": "^0.8.3",
		"@tanstack/router-cli": "^1.167.32",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"gray-matter": "^4.0.3",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"skill": "github:ethan-huo/skill#v0.1.30",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
		"vite-imagetools": "^12.0.0",
		"vite-plus": "0.2.7",
		"wireit": "^0.14.13",
		"wrangler": "^4.118.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "download"
		}
	}
}
