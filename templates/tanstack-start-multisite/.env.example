# Created by `bun run convex:dev` after selecting a Convex deployment.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set these in the Convex deployment, not only in this local file:
# Better Auth resolves the request-specific base URL only from this allowlist.
# Use host[:port] entries, not full URLs.
# bunx convex env set AUTH_ALLOWED_HOSTS "localhost:3000,localhost:3001,alpha.example.com,beta.example.com"
# bunx convex env set SITE_ALPHA_URL http://localhost:3000
# bunx convex env set SITE_BETA_URL http://localhost:3001
# bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
# bunx convex env set GOOGLE_CLIENT_ID ...
# bunx convex env set GOOGLE_CLIENT_SECRET ...
# bunx convex env set RESEND_API_KEY re_...
# bunx convex env set AUTH_EMAIL_FROM "App <auth@example.com>"
# bunx convex env set STRIPE_SECRET_KEY sk_test_...
# bunx convex env set STRIPE_WEBHOOK_SECRET whsec_...
# bunx convex env set STRIPE_PRICE_ID price_...
#
# After the auth variables are set, generate deployment-local Static JWKS:
# bun run auth:jwks
