{
	"compilerOptions": {
		"allowJs": true,
		"strict": true,
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"target": "ESNext",
		"lib": ["ES2023", "dom"],
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"isolatedModules": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../node_modules/.cache/convex/tsconfig.tsbuildinfo"
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
