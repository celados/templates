{
	"name": "template-tanstack-start",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "bun scripts/install-skills.mjs",
		"dev": "wireit",
		"web:dev": "wireit",
		"convex:dev": "wireit",
		"auth:jwks": "convex run auth:getLatestJwks | convex env set JWKS",
		"design-canvas:add": "shadcn add --yes celados/design-canvas/tanstack-start#v0.1.4 && bun run routegen",
		"codegen": "wireit",
		"routegen": "wireit",
		"build": "wireit",
		"preview": "vp preview web",
		"check": "bun run codegen && vp check && tsc -p web/tsconfig.json --noEmit && convex typecheck && bun run cf-typegen:check",
		"deploy": "bun run build && wrangler deploy --cwd web",
		"deploy:temporary": "bun run build && wrangler deploy --cwd web --temporary",
		"cf-typegen": "wireit",
		"cf-typegen:check": "wrangler types --cwd web src/worker-configuration.d.ts --check"
	},
	"wireit": {
		"dev": {
			"dependencies": [
				"web:dev"
			]
		},
		"web:dev": {
			"command": "vp dev web --port 3000 --strictPort",
			"service": true,
			"dependencies": [
				{
					"script": "convex:dev",
					"cascade": false
				},
				"codegen"
			]
		},
		"convex:dev": {
			"command": "convex dev --typecheck-components",
			"service": {
				"readyWhen": {
					"lineMatches": "Convex functions ready!"
				}
			}
		},
		"codegen": {
			"dependencies": [
				"routegen",
				"cf-typegen"
			]
		},
		"routegen": {
			"command": "tsr generate",
			"files": [
				"bun.lock",
				"package.json",
				"tsr.config.json",
				"web/src/routes/**/*"
			],
			"output": [
				"web/src/route-tree.gen.ts"
			]
		},
		"cf-typegen": {
			"command": "wrangler types --cwd web src/worker-configuration.d.ts",
			"files": [
				"package.json",
				"web/wrangler.jsonc"
			],
			"output": [
				"web/src/worker-configuration.d.ts"
			]
		},
		"build": {
			"command": "vp build web",
			"dependencies": [
				"codegen"
			]
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@convex-dev/better-auth": "^0.12.5",
		"@convex-dev/react-query": "^0.1.0",
		"@convex-dev/stripe": "^0.1.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.103.1",
		"@tanstack/react-router": "^1.170.38",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.56",
		"@tanstack/router-plugin": "^1.168.40",
		"better-auth": "~1.6.33",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.46.0",
		"evlog": "^2.29.0",
		"lucide-react": "^1.47.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.56.0",
		"@convex-dev/eslint-plugin": "^5.0.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.12",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-cli": "^1.167.38",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.3.3",
		"vite-plus": "^0.3.3",
		"wireit": "^0.14.13",
		"wrangler": "^4.135.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	}
}
