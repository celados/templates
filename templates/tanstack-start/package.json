{
	"name": "template-tanstack-start",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "bun scripts/install-skills.mjs",
		"dev": "wireit",
		"web:dev": "wireit",
		"convex:dev": "wireit",
		"auth:jwks": "convex run auth:getLatestJwks | convex env set JWKS",
		"codegen": "wireit",
		"routegen": "wireit",
		"build": "wireit",
		"preview": "vp preview web",
		"check": "bun run codegen && vp check && tsc -p web/tsconfig.json --noEmit && convex typecheck && bun run cf-typegen:check",
		"deploy": "bun run build && wrangler deploy --cwd web",
		"deploy:temporary": "bun run build && wrangler deploy --cwd web --temporary",
		"cf-typegen": "wireit",
		"cf-typegen:check": "wrangler types --cwd web src/worker-configuration.d.ts --check"
	},
	"wireit": {
		"dev": {
			"dependencies": [
				"web:dev"
			]
		},
		"web:dev": {
			"command": "vp dev web --port 3000 --strictPort",
			"service": true,
			"dependencies": [
				{
					"script": "convex:dev",
					"cascade": false
				},
				"codegen"
			]
		},
		"convex:dev": {
			"command": "convex dev --typecheck-components",
			"service": {
				"readyWhen": {
					"lineMatches": "Convex functions ready!"
				}
			}
		},
		"codegen": {
			"dependencies": [
				"routegen",
				"cf-typegen"
			]
		},
		"routegen": {
			"command": "tsr generate",
			"files": [
				"bun.lock",
				"package.json",
				"tsr.config.json",
				"web/src/routes/**/*"
			],
			"output": [
				"web/src/route-tree.gen.ts"
			]
		},
		"cf-typegen": {
			"command": "wrangler types --cwd web src/worker-configuration.d.ts",
			"files": [
				"package.json",
				"web/wrangler.jsonc"
			],
			"output": [
				"web/src/worker-configuration.d.ts"
			]
		},
		"build": {
			"command": "vp build web",
			"dependencies": [
				"codegen"
			]
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@convex-dev/better-auth": "^0.12.5",
		"@convex-dev/react-query": "^0.1.0",
		"@convex-dev/stripe": "^0.1.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.34",
		"@tanstack/router-plugin": "^1.168.23",
		"better-auth": "^1.6.25",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.43.0",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.50.0",
		"@tanstack/devtools-vite": "^0.8.3",
		"@tanstack/react-devtools": "^0.10.9",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/router-cli": "^1.167.21",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"jsdom": "^30.0.1",
		"skill": "github:ethan-huo/skill#v0.1.30",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
		"vite-plus": "0.2.7",
		"vitest": "4.1.10",
		"wireit": "^0.14.13",
		"wrangler": "^4.118.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
		"vitest": "4.1.10"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	}
}
